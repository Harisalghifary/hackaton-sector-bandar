# BANDAR env template (§4). Copy to .env and fill in — .env is gitignored.

# Sectors API key (1,000-cr grant) — needed at M1 seed snapshot
SECTORS_API_KEY=

# Watchlist: 6-12 IDX symbols, comma-separated — needed at M1
BANDAR_WATCHLIST=BBRI,BBCA,BMRI,ANTM,DSSA,PTBA,MDKA,ICBP

# Equity in IDR (default 100,000,000) — needed at M2
EQUITY_IDR=100000000

# Gemini API key — needed at M4
GEMINI_API_KEY=

# Anthropic key (fallback/dev, optional) — M4
ANTHROPIC_API_KEY=

# Telegram bot token + chat id — needed at M6
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- optional runtime anchors (no .env needed; handy for demos/tests) ---
# BANDAR_AS_OF=2026-10-06     # replay a seeded day deterministically at 0 cr (camera-safe)
# BANDAR_STATE_DIR=state      # isolate ledger/DB (tests use a temp dir)
# BANDAR_THEME=dark           # UI theme: dark (default) | light
